REFRESH_INTERVAL=60
# Das 13,3″-Spectra-6-Panel mit der mitgelieferten Firmware braucht 1200 × 1600 (1600 × 1200 um 90° gedreht) und BMP.
# Für einen normalen Bildschirm: DISPLAY_ROTATION=0, DISPLAY_THEME=dark oder light, OUTPUT_FORMAT=png
RENDER_WIDTH=1600
RENDER_HEIGHT=1200
DISPLAY_ROTATION=90
DISPLAY_THEME=eink
OUTPUT_FORMAT=bmp
# Optional: "Stand HH:MM" oben rechts auf jeder Seite, damit ein altes Bild als alt erkennbar ist
SHOW_RENDER_TIME=false
# Benachrichtigung bei Geräteausfall: ntfy-Topic, Discord- oder Slack-Webhook; 0 Minuten = nie
NOTIFY_URL=
NOTIFY_OFFLINE_MINUTES=30
# Ereignisse: offline, firmware, errors, sources, daily, weekly
NOTIFY_EVENTS=offline,firmware
NOTIFY_DAILY_HOUR=7
# Adresse des Servers (Links in Nachrichten) und Profilbild (leer = Projektlogo)
NOTIFY_BASE_URL=
NOTIFY_AVATAR_URL=
TIMEZONE=Europe/Berlin
# Bundesland für Feiertage und Schulferien (Kalender, Müllabfuhr, Zeitfenster nur in/außerhalb der Ferien), z. B. DE-HE; leer = aus
HOLIDAY_REGION=

IDLE_MODULES=dwd_weather,tagesschau
# rotation = ein Modul pro Bild im Wechsel, dashboard = Kacheln untereinander
IDLE_LAYOUT=rotation
# nur für dashboard: Reihenfolge und Höhe in Prozent, z. B. dwd_weather:45, calendar:30, garbage:25
DASHBOARD_TILES=
IDLE_MODULE_ROTATION_SECONDS=120
# Zeitplan: Name|Tage|HH:MM-HH:MM|layout|sekunden|inhalte|ferien; … (leere Teile erben vom Programm;
# ferien = nur in den Schulferien, schule = nur außerhalb, leer = immer)
SCHEDULE_WINDOWS=
NIGHT_MODE_ENABLED=false
NIGHT_MODE_START=23:00
NIGHT_MODE_END=07:00
NIGHT_MODE_INTERVAL_MINUTES=15
NIGHT_MODE_IDLE_BEHAVIOR=rotate
NIGHT_MODE_FIXED_MODULE=

PLEX_BASE_URL=
PLEX_TOKEN=
PLEX_MODULE_ENABLED=true
SESSION_PRIORITY=movie,episode,track
STEAM_PROFILE=
STEAM_API_KEY=
STEAM_MODULE_ENABLED=false
STEAM_SHOW_UPDATED_TIMESTAMP=true

DWD_WEATHER_STATION_ID=10532
DWD_WEATHER_CACHE_SECONDS=900
DWD_HOURLY_START=day_start
DWD_HOURLY_INTERVAL_HOURS=2
DWD_UV_CITY=
DWD_POLLEN_REGION=
DWD_POLLEN_ALLERGENS=

TAGESSCHAU_IDLE_CACHE_SECONDS=900

# Müllabfuhr: 'Label|URL; Label|URL', Jahr in der URL durch {year} ersetzen
GARBAGE_ICS_URLS=
GARBAGE_DAYS_AHEAD=14
GARBAGE_CACHE_SECONDS=21600
GARBAGE_TYPE_COLORS=
# Darstellung der nächsten Tage: strip (Wochenstreifen) oder list; mehrere Adressen: merged oder columns
GARBAGE_UPCOMING_STYLE=strip
GARBAGE_LAYOUT=merged
# Ab dieser Stunde am Vortag "Morgen rausstellen" + Vorrang in der Rotation; ab dieser Stunde am Abfuhrtag gilt der Termin als erledigt
GARBAGE_REMINDER_HOUR=18
GARBAGE_DONE_HOUR=12

# Kalender: 'Label|URL; Label|URL' (Google/Nextcloud/iCloud privater ICS-Link)
CALENDAR_ICS_URLS=
CALENDAR_DAYS_AHEAD=7
CALENDAR_MAX_EVENTS=14
CALENDAR_CACHE_SECONDS=900
CALENDAR_HIDE_PAST_TODAY=true
# Feiertage und Ferien im Kalender (both, public, off) – braucht HOLIDAY_REGION
CALENDAR_HOLIDAYS=both

# NINA-Warnungen: Ort (Name oder Regionalschlüssel), gewarnt wird für den ganzen Kreis
NINA_REGION=
NINA_MIN_SEVERITY=minor
NINA_CACHE_SECONDS=300

GALLERY_PATHS=
GALLERY_RECURSIVE=true
GALLERY_ORDER=random
GALLERY_INTERVAL_MODE=idle_rotation
GALLERY_INTERVAL_SECONDS=300
GALLERY_AVOID_RECENT_COUNT=5
GALLERY_FIT_MODE=fit_blur_bg
GALLERY_OVERLAY_MODE=none
